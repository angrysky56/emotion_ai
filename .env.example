# Aura local runtime example
# ==========================
# Copy this file to .env only when you want to customize Aura. Keep real
# credentials in your private environment; never commit them.

# Local-first conversation provider
AURA_DEFAULT_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Private local network boundary
AURA_HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000
AURA_RELOAD=false
DEBUG=false
LOG_LEVEL=INFO

# User-owned local storage
CHROMA_PERSIST_DIRECTORY=./aura_chroma_db
AURA_DATA_DIRECTORY=./aura_data

# Local Memvid embeddings (optional feature)
MEMVID_EMBEDDING_PROVIDER=ollama
MEMVID_EMBEDDING_MODEL=embeddinggemma:latest

# Optional Gemini cloud provider
# To select it, change AURA_DEFAULT_PROVIDER to gemini and set these values in
# your private environment. The sentinel below is not a credential.
# AURA_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=<set-in-private-environment>

# Optional OpenRouter cloud provider
# To select it, change AURA_DEFAULT_PROVIDER to openrouter and set these values
# in your private environment. The sentinel below is not a credential.
# OPENROUTER_MODEL=deepseek/deepseek-r1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=<set-in-private-environment>

# Optional cloud embeddings for Memvid are separate explicit choices.
# For Google, change MEMVID_EMBEDDING_PROVIDER to google and use model
# embedding-001. For OpenAI, change MEMVID_EMBEDDING_PROVIDER to openai and set:
# OPENAI_API_KEY=<set-in-private-environment>

# Conversation behavior
AURA_MAX_OUTPUT_TOKENS=1000000
THINKING_BUDGET=-1
INCLUDE_THINKING_IN_RESPONSE=false
FORCE_PURE_THINKING_EXTRACTION=false
THINKING_DEBUG=false
MAX_FUNCTION_CALL_ROUNDS=3
AFC_MAX_MAIN_REMOTE_CALLS=10

# Autonomic cloud behavior is disabled unless the operator opts in explicitly.
AUTONOMIC_ENABLED=false
AUTONOMIC_TASK_THRESHOLD=medium
# To opt in, set AUTONOMIC_ENABLED to true and configure a cloud credential.
# AURA_AUTONOMIC_MODEL=gemini-2.0-flash-lite
AURA_AUTONOMIC_MAX_OUTPUT_TOKENS=100000
AFC_AUTONOMIC_MAX_REMOTE_CALLS=30
AUTONOMIC_MAX_CONCURRENT_TASKS=30
AUTONOMIC_RATE_LIMIT_RPM=30
AUTONOMIC_RATE_LIMIT_RPD=1400
AUTONOMIC_TIMEOUT_SECONDS=600
AUTONOMIC_QUEUE_MAX_SIZE=30
AUTONOMIC_QUEUE_PRIORITY_ENABLED=true

# Main-model rate limits remain operator-controlled.
MAIN_MODEL_RATE_LIMIT_RPM=10
MAIN_MODEL_RATE_LIMIT_RPD=500

# Feature switches retained for the current runtime.
ENABLE_EMOTIONAL_ANALYSIS=true
ENABLE_COGNITIVE_TRACKING=true
ENABLE_VECTOR_SEARCH=true
ENABLE_FILE_EXPORTS=true

# Optional standalone MCP identity. MCP is not part of normal Aura readiness.
MCP_SERVER_NAME=aura-companion
MCP_SERVER_VERSION=1.0.0
